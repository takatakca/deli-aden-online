PORT=3000

# SMTP — Nodemailer
SMTP_HOST=mail.deliaden.ca
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notify@deliaden.ca
SMTP_PASS=your_email_password

# Email addresses
FROM_EMAIL=notify@deliaden.ca
RESTAURANT_EMAIL=orders@deliaden.ca

# Admin dashboard
ADMIN_PASSWORD=change-this-password

# SQLite location (optional, defaults to ./data/deli-aden.db)
# DB_PATH=/home/USER/deliaden/data/deli-aden.db
