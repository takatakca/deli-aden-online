NODE_ENV=production
PORT=3000

# ---- Database (MySQL/MariaDB — recommended for production) ----
# If DB_HOST is set, the server uses MySQL. Otherwise it falls back to SQLite.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---- SQLite fallback (only used if DB_HOST is empty) ----
# DB_PATH=/home/USER/deliaden/data/deli-aden.db

# ---- SMTP — Nodemailer ----
SMTP_HOST=mail.deliaden.ca
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notify@deliaden.ca
SMTP_PASS=your_email_password

# ---- Email addresses ----
FROM_EMAIL=notify@deliaden.ca
RESTAURANT_EMAIL=orders@deliaden.ca

# ---- Admin dashboard ----
ADMIN_PASSWORD=change-this-password
